[Unit]
Description=Arai Lab API (FastAPI + MySQL)
After=network.target mysql.service
Wants=mysql.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/arai-website/backend
# pydantic-settings reads backend/.env from this WorkingDirectory.
ExecStart=/home/ubuntu/arai-website/backend/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
