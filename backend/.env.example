# Copy this file to `.env` and fill in real values on the server.
# NEVER commit the real .env — it is gitignored.

# --- Database ---
# MySQL connection (app user, not root). utf8mb4 is required for Japanese text.
DATABASE_URL=mysql+pymysql://arai_app:CHANGE_ME@127.0.0.1:3306/arai_lab?charset=utf8mb4

# --- Auth / JWT ---
# Generate a long random secret:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# --- Initial admin account ---
# Used only to create the first admin user if none exists yet.
# After first login you should change the password from the dashboard.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME

# --- CORS ---
# Comma-separated list of allowed origins, or * for any (the API is same-origin
# behind nginx in production, so this mostly matters for local dev).
CORS_ORIGINS=*

# --- Uploaded images ---
# Persistent directory for admin-uploaded member photos. MUST live outside the
# build dir that deploy.sh wipes, and be served by nginx at UPLOAD_URL_PREFIX.
# On the server: UPLOAD_DIR=/var/www/arai-uploads served at /uploads/.
UPLOAD_DIR=/var/www/arai-uploads
UPLOAD_URL_PREFIX=/uploads
MAX_UPLOAD_MB=8

# --- Publication auto-sync (OpenAlex, free, no key) ---
# Prof. Keigo Arai's OpenAlex author id; mailto joins the polite API pool.
OPENALEX_AUTHOR_ID=A5026665424
OPENALEX_MAILTO=admin@qig-lab.net
